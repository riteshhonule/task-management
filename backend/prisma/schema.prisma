datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  ON_HOLD
  BLOCKED
  SUBMITTED
  PENDING_REVIEW
  REVIEW_PENDING
  APPROVED
  REVISION_REQUIRED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskType {
  NEW_TASK
  CARRY_FORWARD_TASK
  ADMIN_ASSIGNED_TASK
  EMPLOYEE_ASSIGNED_TASK
}

enum MessageType {
  NORMAL
  MANDATORY_RESPONSE
}

enum MessageResponseStatus {
  ACCEPT
  REJECT
  COMMENT
  DISMISSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                        Int                         @id @default(autoincrement())
  email                     String                      @unique
  mobileNumber              String?
  jobRole                   String?
  password                  String
  name                      String
  role                      Role                        @default(EMPLOYEE)
  deletedAt                 DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  tasks                     Task[]                      @relation("EmployeeTasks")
  messagesSent              Message[]                   @relation("SenderMessages")
  messageResponses          MessageResponse[]           @relation("EmployeeResponses")
  leaves                    Leave[]                     @relation("EmployeeLeaves")
  leavesApproved            Leave[]                     @relation("ApprovedLeaves")
  announcementsCreated      Announcement[]              @relation("CreatorAnnouncements")
  announcementAcks          AnnouncementAck[]           @relation("UserAcks")
  notifications             Notification[]              @relation("UserNotifications")
  sentNotifications         Notification[]              @relation("SenderNotifications")
  uploadedAttachments       Attachment[]                @relation("UploadedBy")
  activityLogs              ActivityLog[]               @relation("UserLogs")
  projectAllocations        ProjectAllocation[]         @relation("UserAllocations")
  notificationTokens        NotificationToken[]         @relation("UserTokens")
  passwordResetTokens       PasswordResetToken[]        @relation("UserPasswordResetTokens")
  adminCommentUpdatedTasks  TaskProject[]               @relation("AdminCommentUpdatedTasks")
  assignedByTasks           TaskProject[]               @relation("AssignedByTasks")
  assignedToTasks           TaskProject[]               @relation("AssignedToTasks")
  submissions               TaskSubmission[]            @relation("EmployeeSubmissions")
  reviewedRevisions         TaskRevision[]              @relation("ReviewerRevisions")
  reviewedApprovals         TaskApproval[]              @relation("ReviewerApprovals")
  performedTimelines        TaskTimeline[]              @relation("PerformedTimeline")
  approvedTasks             TaskProject[]               @relation("ApprovedTasksRelation")
}

model NotificationToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation("UserTokens", fields: [userId], references: [id], onDelete: Cascade)
  fcmToken   String   @unique
  deviceType String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isArchived  Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt    DateTime      @updatedAt
  taskProjects TaskProject[] @relation("ProjectTasks")
  allocations ProjectAllocation[] @relation("ProjectAllocations")
}

model ProjectAllocation {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation("ProjectAllocations", fields: [projectId], references: [id])
  userId    Int
  user      User     @relation("UserAllocations", fields: [userId], references: [id])
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([projectId, userId])
}

model Task {
  id                      Int            @id @default(autoincrement())
  startDate               DateTime       @default(now())
  employeeId              Int
  employee                User           @relation("EmployeeTasks", fields: [employeeId], references: [id])
  startTime               String
  expectedEndDate         DateTime?
  projects                TaskProject[]  @relation("TaskProjectsRelation")
  carryForwardedFromId    Int?           @unique
  carryForwardedFrom      Task?          @relation("CarryForwardRelation", fields: [carryForwardedFromId], references: [id])
  carryForwardedTo        Task?          @relation("CarryForwardRelation")
  deletedAt               DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  attachments             Attachment[]   @relation("TaskAttachments")
}

model TaskProject {
  id                       Int            @id @default(autoincrement())
  taskId                   Int
  task                     Task           @relation("TaskProjectsRelation", fields: [taskId], references: [id], onDelete: Cascade)
  projectId                Int
  project                  Project        @relation("ProjectTasks", fields: [projectId], references: [id])
  taskDescription          String
  changesGivenBy           String?
  changesSummary           String?
  adminEditedDescription   Boolean        @default(false)
  priority                 TaskPriority   @default(MEDIUM)
  status                   TaskStatus     @default(PENDING)
  delayReason              String?
  blockedReason            String?
  notes                    String?
  completedWorkDescription String?
  completionPercentage     Int?           @default(0)
  deletedAt                DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  updates                  TaskUpdate[]   @relation("TaskProjectUpdates")
  acceptanceStatus         String         @default("PENDING") // PENDING, ACCEPTED, REJECTED
  rejectionReason          String?
  adminComment             String?
  adminCommentUpdatedAt    DateTime?
  adminCommentUpdatedById  Int?
  adminCommentUpdatedBy    User?          @relation("AdminCommentUpdatedTasks", fields: [adminCommentUpdatedById], references: [id])
  startTime                String?
  endTime                  String?
  jobRoleType              String?
  customJobRole            String?
  proofRequired            Boolean        @default(false)
  assignedByUserId         Int?
  assignedBy               User?          @relation("AssignedByTasks", fields: [assignedByUserId], references: [id])
  assignedToUserId         Int?
  assignedTo               User?          @relation("AssignedToTasks", fields: [assignedToUserId], references: [id])
  assignmentType           String?
  reviewStatus             String?        @default("PENDING")
  submissions              TaskSubmission[] @relation("ProjectSubmissions")
  timeline                 TaskTimeline[]   @relation("ProjectTimeline")
  taskType                 TaskType       @default(NEW_TASK)
  estimatedEffort          Float?
  timeSpent                Float?
  blockers                 String?
  approvedById             Int?
  approvedBy               User?          @relation("ApprovedTasksRelation", fields: [approvedById], references: [id])
  approvedDate             DateTime?
  approvalComment          String?
  expectedEndDate          DateTime?
}

model TaskUpdate {
  id           Int          @id @default(autoincrement())
  taskProjectId Int
  taskProject  TaskProject  @relation("TaskProjectUpdates", fields: [taskProjectId], references: [id], onDelete: Cascade)
  statusBefore TaskStatus
  statusAfter  TaskStatus
  remarks      String?
  screenshotUrl String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Announcement {
  id          Int               @id @default(autoincrement())
  title       String
  content     String
  creatorId   Int
  creator     User              @relation("CreatorAnnouncements", fields: [creatorId], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  acks        AnnouncementAck[] @relation("AnnouncementAcks")
}

model AnnouncementAck {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation("AnnouncementAcks", fields: [announcementId], references: [id])
  userId         Int
  user           User         @relation("UserAcks", fields: [userId], references: [id])
  acknowledgedAt DateTime     @default(now())
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Notification {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation("UserNotifications", fields: [userId], references: [id])
  senderId      Int?
  sender        User?     @relation("SenderNotifications", fields: [senderId], references: [id])
  type          String    // TASK_ASSIGNED, TASK_UPDATED, ANNOUNCEMENT, MESSAGE, LEAVE_STATUS
  title         String
  message       String
  relatedTaskId Int?
  status        String    @default("SENT") // SENT, DELIVERED, SEEN
  isDelivered   Boolean   @default(false)
  deliveredAt   DateTime?
  isRead        Boolean   @default(false)
  readAt        DateTime?
  seenAt        DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id           Int               @id @default(autoincrement())
  senderId     Int
  sender       User              @relation("SenderMessages", fields: [senderId], references: [id])
  content      String
  type         MessageType       @default(NORMAL)
  recipientIds Int[]
  isEveryone   Boolean           @default(false)
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  responses    MessageResponse[] @relation("MessageResponses")
}

model MessageResponse {
  id          Int                   @id @default(autoincrement())
  messageId   Int
  message     Message               @relation("MessageResponses", fields: [messageId], references: [id])
  employeeId  Int
  employee    User                  @relation("EmployeeResponses", fields: [employeeId], references: [id])
  response    MessageResponseStatus
  comment     String?
  respondedAt DateTime              @default(now())
  deletedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model Leave {
  id            Int         @id @default(autoincrement())
  employeeId    Int
  employee      User        @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  leaveType     String      @default("Casual Leave")
  startDate     DateTime
  endDate       DateTime
  reason        String
  attachmentUrl String?
  status        LeaveStatus @default(APPROVED)
  approvedById  Int?
  approvedBy    User?       @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  remarks       String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  attachments   Attachment[] @relation("LeaveAttachments")
}

model Attachment {
  id           Int       @id @default(autoincrement())
  filename     String
  filepath     String
  mimetype     String
  size         Int
  taskId       Int?
  task         Task?     @relation("TaskAttachments", fields: [taskId], references: [id])
  leaveId      Int?
  leave        Leave?    @relation("LeaveAttachments", fields: [leaveId], references: [id])
  uploadedById Int
  uploadedBy   User      @relation("UploadedBy", fields: [uploadedById], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ActivityLog {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("UserLogs", fields: [userId], references: [id])
  action    String
  details   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaskCarryForward {
  id                     Int      @id @default(autoincrement())
  taskId                 Int
  employeeId             Int
  fromDate               DateTime
  toDate                 DateTime
  reason                 String?
  isDeadlineCarryForward Boolean  @default(false)
  createdAt              DateTime @default(now())
}

model TaskSubmission {
  id               Int                 @id @default(autoincrement())
  taskProjectId    Int
  taskProject      TaskProject         @relation("ProjectSubmissions", fields: [taskProjectId], references: [id], onDelete: Cascade)
  employeeId       Int
  employee         User                @relation("EmployeeSubmissions", fields: [employeeId], references: [id])
  comment          String?
  createdAt        DateTime            @default(now())
  proofs           TaskProof[]         @relation("SubmissionProofs")
  revisions        TaskRevision[]      @relation("SubmissionRevisions")
  approvals        TaskApproval[]      @relation("SubmissionApprovals")
  timeSpent        Float?
  blockers         String?
  notes            String?
}

model TaskProof {
  id               Int            @id @default(autoincrement())
  taskSubmissionId Int
  taskSubmission   TaskSubmission @relation("SubmissionProofs", fields: [taskSubmissionId], references: [id], onDelete: Cascade)
  filename         String
  filepath         String
  mimetype         String
  size             Int
  createdAt        DateTime       @default(now())
}

model TaskRevision {
  id               Int            @id @default(autoincrement())
  taskSubmissionId Int
  taskSubmission   TaskSubmission @relation("SubmissionRevisions", fields: [taskSubmissionId], references: [id], onDelete: Cascade)
  reviewerId       Int
  reviewer         User           @relation("ReviewerRevisions", fields: [reviewerId], references: [id])
  comment          String
  createdAt        DateTime       @default(now())
}

model TaskApproval {
  id               Int            @id @default(autoincrement())
  taskSubmissionId Int
  taskSubmission   TaskSubmission @relation("SubmissionApprovals", fields: [taskSubmissionId], references: [id], onDelete: Cascade)
  reviewerId       Int
  reviewer         User           @relation("ReviewerApprovals", fields: [reviewerId], references: [id])
  comment          String?
  createdAt        DateTime       @default(now())
}

model TaskTimeline {
  id               Int            @id @default(autoincrement())
  taskProjectId    Int
  taskProject      TaskProject    @relation("ProjectTimeline", fields: [taskProjectId], references: [id], onDelete: Cascade)
  action           String         // e.g., Task Created, Assigned, Started, Review Submitted, Proof Uploaded, Revision Requested, Proof Uploaded Again, Approved, Completed
  performedById    Int
  performedBy      User           @relation("PerformedTimeline", fields: [performedById], references: [id])
  details          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}
